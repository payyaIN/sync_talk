{
  "info": {
    "name": "SyncTalk API Full",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"a@b.com\", \"password\": \"secret123\", \"displayName\": \"Alice\"}"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"a@b.com\", \"password\": \"secret123\"}"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Refresh",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\"refreshToken\": \"<paste>\"}"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      }
    },
    {
      "name": "Search Users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users/search",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "urlScript": {
          "query": [
            {
              "key": "q",
              "value": "ali"
            }
          ]
        }
      }
    },
    {
      "name": "Create Conversation",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/conversations",
        "body": {
          "mode": "raw",
          "raw": "{\"participants\": [\"<userId>\"], \"title\": \"Chat\"}"
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "List Messages",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/messages/{{conversationId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      }
    },
    {
      "name": "Send Message",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/messages/{{conversationId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"content\": \"Hello\"}"
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Upload",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/uploads",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "multipart/form-data"
          }
        ]
      }
    },
    {
      "name": "Profile Update",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/users/me",
        "body": {
          "mode": "raw",
          "raw": "{\"displayName\": \"New Name\", \"avatarUrl\": \"https://...\"}"
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Delete Message (admin)",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/messages/{{messageId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      }
    },
    {
      "name": "Audit Logs",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/audit",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      }
    },
    {
      "name": "Search Messages",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/messages/search",
        "urlScript": {
          "query": [
            {
              "key": "q",
              "value": "hello"
            }
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    }
  ]
}